<section class="ve-fcb ve-section">
  <div class="ve-page">
    <div class="ve-fcb__grid">
      <div class="ve-fcb__copy">
        <span class="ve-eyebrow">{{ section.settings.eyebrow | default: 'NEW' }}</span>
        <h2 class="ve-h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.lead != blank -%}<p class="ve-lead">{{ section.settings.lead }}</p>{%- endif -%}
        {%- if section.settings.cta_text != blank -%}<a class="ve-btn" href="{{ section.settings.cta_link }}">{{ section.settings.cta_text }}</a>{%- endif -%}
      </div>
      <div class="ve-fcb__media">
        {%- if section.settings.image != blank -%}{%- assign falt = section.settings.heading | escape -%}{{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: falt, class: 've-fcb__img' }}
        {%- elsif section.settings.fallback_url != blank -%}<img src="{{ section.settings.fallback_url }}" class="ve-fcb__img" alt="" width="1400" height="900" loading="lazy">{%- endif -%}
      </div>
    </div>
    {%- assign coll = section.settings.collection -%}
    {%- if coll.products.size > 0 -%}
      <div class="ve-fcb__products">
        {%- for product in coll.products limit: 4 -%}{% render 'product-card', product: product %}{%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>
{% stylesheet %}
.ve-fcb__grid { display: grid; grid-template-columns: 1fr 1.4fr; gap: 3rem; align-items: center; margin-bottom: 2.5rem; }
.ve-fcb__copy { display: grid; gap: 1rem; max-width: 44ch; }
.ve-fcb__img { width: 100%; aspect-ratio: 16/10; object-fit: cover; border-radius: 8px; }
.ve-fcb__products { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
@media (max-width: 880px) { .ve-fcb__grid { grid-template-columns: 1fr; } .ve-fcb__products { grid-template-columns: repeat(2, 1fr); } }
{% endstylesheet %}
{% schema %}
{ "name": "Featured collection band", "tag": "section", "settings": [
  { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "JUST IN" },
  { "type": "text", "id": "heading", "label": "Heading", "default": "The fall edit." },
  { "type": "textarea", "id": "lead", "label": "Lead", "default": "Six new pieces sourced through the season." },
  { "type": "collection", "id": "collection", "label": "Collection" },
  { "type": "image_picker", "id": "image", "label": "Image" },
  { "type": "text", "id": "fallback_url", "label": "Fallback image URL" },
  { "type": "text", "id": "cta_text", "label": "CTA text", "default": "See the edit" },
  { "type": "url", "id": "cta_link", "label": "CTA link" }
], "presets": [{ "name": "Featured collection band" }]}
{% endschema %}
