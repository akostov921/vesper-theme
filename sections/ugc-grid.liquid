<section class="ve-ugc ve-section">
  <div class="ve-page">
    <header class="ve-ugc__head">
      <div>
        <span class="ve-eyebrow">{{ section.settings.eyebrow | default: 'COMMUNITY' }}</span>
        <h2 class="ve-h2">{{ section.settings.heading | default: 'In the wild.' }}</h2>
      </div>
      {%- if section.settings.hashtag != blank -%}<small class="ve-ugc__tag">#{{ section.settings.hashtag }}</small>{%- endif -%}
    </header>
    <div class="ve-ugc__grid">
      {%- for block in section.blocks -%}
        <a class="ve-ugc__tile" href="{{ block.settings.link | default: '#' }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy' }}{%- elsif block.settings.fallback_url != blank -%}<img src="{{ block.settings.fallback_url }}" alt="" width="500" height="500" loading="lazy">{%- endif -%}
          {%- if block.settings.handle != blank -%}<span class="ve-ugc__handle">@{{ block.settings.handle }}</span>{%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% stylesheet %}
.ve-ugc__head { display: flex; justify-content: space-between; align-items: end; margin-bottom: 2rem; gap: 1rem; }
.ve-ugc__head h2 { margin-top: 0.25rem; }
.ve-ugc__tag { font-size: 0.875rem; opacity: 0.7; }
.ve-ugc__grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 0.5rem; }
.ve-ugc__tile { position: relative; overflow: hidden; aspect-ratio: 1; display: block; }
.ve-ugc__tile img { width: 100%; height: 100%; object-fit: cover; transition: transform 600ms cubic-bezier(0.16, 1, 0.3, 1); }
.ve-ugc__tile:hover img { transform: scale(1.05); }
.ve-ugc__handle { position: absolute; left: 0.5rem; bottom: 0.5rem; background: rgba(255,255,255,0.92); padding: 0.15rem 0.5rem; border-radius: 999px; font-size: 0.7rem; backdrop-filter: blur(4px); }
@media (max-width: 880px) { .ve-ugc__grid { grid-template-columns: repeat(3, 1fr); } }
{% endstylesheet %}
{% schema %}
{ "name": "UGC grid", "tag": "section", "settings": [
  { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "COMMUNITY" },
  { "type": "text", "id": "heading", "label": "Heading", "default": "In the wild." },
  { "type": "text", "id": "hashtag", "label": "Hashtag (without #)" }
], "blocks": [
  { "type": "post", "name": "Post", "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "fallback_url", "label": "Fallback URL (Unsplash)" },
    { "type": "text", "id": "handle", "label": "@handle" },
    { "type": "url", "id": "link", "label": "Link" }
  ]}
], "max_blocks": 12, "presets": [{ "name": "UGC grid", "blocks": [
  { "type": "post" }, { "type": "post" }, { "type": "post" }, { "type": "post" }, { "type": "post" }, { "type": "post" }
]}]}
{% endschema %}
