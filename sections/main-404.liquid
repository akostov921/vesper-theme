{%- comment %}
  State pattern: 404-editorial-quiet (different from Storynest's narrative-warm).
  Catalogue: ~/Desktop/design-library/patterns/states/_INDEX.md
{% endcomment -%}
<section class="ve-404 ve-section--ample">
  <div class="ve-page ve-page--narrow ve-404__inner">
    <span class="ve-eyebrow">404</span>
    <h1 class="ve-display ve-italic">Page not found.</h1>
    <p class="ve-lead">{{ 'general.404.subtext' | t }}</p>
    <a class="ve-link" href="{{ routes.root_url }}">{{ 'general.404.link' | t }}</a>
  </div>
</section>
<style>
  .ve-404__inner { text-align: left; display: grid; gap: var(--ve-space-4); }
</style>

{% schema %}{ "name": "404", "tag": "section" }{% endschema %}
