{%- assign aspect = aspect | default: 'square' -%}
<a class="ve-card ve-reveal" href="{{ product.url }}">
  <div class="ve-card__media ve-card__media--{{ aspect }}">
    {%- if product.featured_image -%}
      {%- assign hh_alt = product.title | escape -%}
      {{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300,500,800', sizes: '(min-width: 880px) 30vw, 50vw', alt: hh_alt, class: 've-card__img' }}
    {%- else -%}
      <span class="ve-card__ph">◦</span>
    {%- endif -%}
  </div>
  <div class="ve-card__body">
    {%- if product.vendor != blank -%}<small class="ve-card__author">{{ product.vendor }}</small>{%- endif -%}
    <h3 class="ve-card__title ve-italic">{{ product.title }}</h3>
    <span class="ve-card__price">{{ product.price | money_without_trailing_zeros }}</span>
  </div>
</a>

{% stylesheet %}
.ve-card { display: block; color: inherit; }
.ve-card__media { background: var(--ve-bg-2); overflow: hidden; border-radius: var(--ve-radius); }
.ve-card__media--cover { aspect-ratio: 3 / 4; }
.ve-card__media--square { aspect-ratio: 1 / 1; }
.ve-card__media--landscape { aspect-ratio: 4 / 3; }
.ve-card__img { width: 100%; height: 100%; object-fit: cover; transition: opacity var(--ve-dur-slow) var(--ve-ease); }
.ve-card:hover .ve-card__img { opacity: 0.92; }
.ve-card__ph { display: grid; place-items: center; aspect-ratio: 1; color: var(--ve-sage); font-family: var(--ve-serif); font-size: 2.5rem; }
.ve-card__body { padding-top: var(--ve-space-3); }
.ve-card__author { color: var(--ve-ink-mute); font-size: var(--ve-fs-xs); display: block; text-transform: uppercase; letter-spacing: 0.06em; }
.ve-card__title { font-family: var(--ve-serif); font-style: italic; font-size: 1.0625rem; margin-top: 2px; }
.ve-card__price { display: block; margin-top: var(--ve-space-1); color: var(--ve-ink-soft); font-size: var(--ve-fs-sm); }
{% endstylesheet %}
