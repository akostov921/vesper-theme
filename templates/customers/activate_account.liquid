<section class="ve-section"><div class="ve-page ve-page--narrow">
  <h1 class="ve-display">Activate account</h1>
  <p class="ve-lead">Set a password to finish activating your account.</p>
  {%- form 'activate_customer_password' -%}
    {{ form.errors | default_errors }}
    <label class="ve-eyebrow">Password <input class="ve-input" name="customer[password]" type="password" required></label>
    <label class="ve-eyebrow">Confirm <input class="ve-input" name="customer[password_confirmation]" type="password" required></label>
    <button type="submit" class="ve-btn">Activate</button>
  {%- endform -%}
</div></section>
