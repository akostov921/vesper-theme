<section class="ve-section"><div class="ve-page ve-page--narrow">
  <h1 class="ve-display">Reset password</h1>
  {%- form 'reset_customer_password' -%}
    {{ form.errors | default_errors }}
    <label class="ve-eyebrow">New password <input class="ve-input" name="customer[password]" type="password" required></label>
    <label class="ve-eyebrow">Confirm <input class="ve-input" name="customer[password_confirmation]" type="password" required></label>
    <button type="submit" class="ve-btn">Reset</button>
  {%- endform -%}
</div></section>
